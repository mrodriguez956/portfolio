---
import Layout from "../layouts/Layout.astro";
import Welcome from "../components/Welcome.astro";
import Projects from "../components/Projects.astro";
import Display from "../components/Display.astro";
import Skills from "../components/Skills.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import projectImage from "../assets/Projects.svg";
---

<Layout>
    <Welcome />
    <section>
        <h2 class="section-header text-center text-[40px] flex justify-center">
            <img
                class="rounded-lg w-[400px]"
                src={projectImage.src}
                alt="Projects"
            />
        </h2>
        <div class="grid grid-cols-4">
            <Projects />
            <Display />
        </div>
    </section>
    <section class="content-section">
        <About />
    </section>
    <section class="content-section">
        <Skills />
    </section>
    <section class="content-section">
        <Contact />
    </section>
    <script src="../scripts/script.ts"></script>
</Layout>
