<section class="content-section contact-form w-full">
    <!-- modify this form HTML and place wherever you want your form -->
    <div class="w-full">
        <form
            class="grid gap-4"
            id="my-form"
            action="https://formspree.io/f/xnjqrwzz"
            method="POST"
        >
            <label for="name">Name</label>
            <input type="name" name="name" id="name" />
            <label for="email">Email:</label>
            <input type="email" name="email" id="email" />
            <label for="message">Message:</label>
            <textarea
                id="message"
                name="message"
                rows="4"
                cols="50"
                placeholder="Type your message here..."></textarea>
            <button id="my-form-button">Submit</button>
            <p id="my-form-status"></p>
        </form>
    </div>
</section>

<style>
    .contact-form form {
        display: grid;
        gap: 1rem;
    }

    .contact-form label {
        font-family: "OptiStevas", sans-serif;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 2px;
        color: #ccc;
    }

    .contact-form input {
        background-color: white;
        border: 1px solid #444;
        border-radius: 4px;
        padding: 0.5rem;
        color: #eee;
    }
    .contact-form textarea {
        background-color: white;
        border: 1px solid #444;
        border-radius: 4px;
        padding: 0.5rem;
        color: black;
    }

    .contact-form button {
        background: linear-gradient(180deg, #333 0%, #222 100%);
        border: 1px solid #444;
        border-radius: 4px;
        padding: 0.75rem;
        color: #eee;
        font-family: "OptiStevas", sans-serif;
        text-transform: uppercase;
        letter-spacing: 2px;
