---
import dbdVHS from "../assets/VHS-DBD-V.png";
import twVHS from "../assets/VHS-TW-V.png";

const identity = {
    firstName: "Michael",
    country: "Texas",
    occupation: "Help Desk Support Technician",
    education:
        "Bachelor's Degree in Computer Science (University of Texas at San Antonio)",
    hobbies: ["Gaming", "Web Dev", "card collecting"],
    food: ["Sandwiches"],
    favoriteWorks: ["Donnie Darko", "Late Night with the Devil", "Mr. Robot"],
};

const projects = [
    {
        title: "Dead by Daylight 90's Generator",
        description: "Custom Icon Generator for Dead by Daylight",
        image: dbdVHS,
        preview: "https://placecats.com/g/300/200",
    },
    {
        title: "Wordpress Shop Theme",
        description: "Custom Wordpress Theme inspired by Shirtz.cool",
        image: dbdVHS,
        preview: "https://placecats.com/millie_neo/300/200",
    },
    {
        title: "TimeWizard",
        description: "Another cool project",
        image: twVHS,
        preview: "https://placecats.com/bella/300/200",
    },
];

const skillColor = "white";
const fontWeight = "bold";
const textCase = "uppercase";
---

<div class="md:hidden flex items-center h-[280px] px-[5px] text-center mr-5">
    {
        projects.map(
            (project) =>
                project.image && (
                    <img
                        class="tape h-[260px] w-auto mr-4"
                        src={project.image.src}
                        alt={project.title}
                        data-preview={project.preview}
                    />
                ),
        )
    }
</div>
