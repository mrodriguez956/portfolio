---
import tape from "../assets/tape.png";
import mask from "../assets/HeroMask.svg";
---

<div
    class="hero-section relative grid grid-cols-1 md:grid-cols-5 text-white sm:text-left md:text-center p-5 md:p-10 items-center overflow-hidden min-h-[25vh] md:min-h-[30vh] lg:min-h-[40vh]"
>
    <div class="relative z-10 h-full flex flex-col hero-name md:col-span-3">
        <span class="text-lg lg:text-2xl text-wheat hero-sub">
            Michael Rodriguez Presents
        </span>
        <div class="relative inline-block md:block">
            <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl hero-main">
                FULL STACK <br />ENGINEER
            </h1>

            <span
                class="text-red-600 text-4xl md:text-6xl lg:text-7xl
                                  font-['TDreams']"
            >
                Portfolio
            </span>
        </div>

        <div class="py-2 text-lg sm:text-lg lg:text-2xl hero-sub">
            Creating analog experiences in the digital realm.
        </div>
    </div>
    <img
        class="absolute left-0 top-0 h-full w-full object-cover z-8"
        src={mask.src}
    />
    <img
        class="absolute right-0 top-0 h-full object-contain z-0"
        src={tape.src}
        alt="A VHS tape with a custom label"
    />
</div>
