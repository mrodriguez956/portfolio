---
import astroLogo from "../assets/astro.svg";
import background from "../assets/background.svg";
---

<div class="flex items-center justify-center p-16 text-white">
    <!--
    This wrapper is the key.
    - `relative`: Makes this the positioning context for its children.
  -->
    <div class="relative">
        <!-- 1. The Image -->
        <img
            class="hero-img w-[500px] h-auto rounded-lg shadow-2xl"
            src="https://static.photos/bokeh/640x360"
            alt="Abstract background"
        />

        <!-- 2. The Overlapping Name -->
        <!--
      - `absolute`: Positions this div relative to the parent above.
      - `-bottom-5 -right-5`: The negative values push the div *outside*
        the parent's boundaries at the bottom-right corner.
    -->
        <div
            class="hero-name absolute -bottom-5 -right-5 bg-black border-2 border-purple-500 p-4 rounded-md"
        >
            <span class="text-3xl font-bold text-wheat">Michael Rodriguez</span>
        </div>
    </div>

    <!-- You can add your description content here later -->
    <div id="hero-description"></div>

    <br class="line" />
</div>
