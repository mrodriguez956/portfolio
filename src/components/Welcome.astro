---
import tape from "../assets/tape2.png";
---

<div
    class="grid grid-cols-1 md:grid-cols-5 text-white p-5 md:p-10 items-center"
>
    <div class="hero-name md:col-span-3">
        <span class="lg:text-2xl font-bold text-wheat">
            from the console of Michael Rodriguez
        </span>
        <h1 class="text-[55px] xl:text-[110px] leading-none">
            Full-Stack Engineer
        </h1>
        <div class="py-2 lg:text-3xl">
            Creating analog experiences in the digital realm.
        </div>
    </div>
    <div class="md:col-span-2 tape-container">
        <img
            class="tape-img"
            src={tape.src}
            alt="A VHS tape with a custom label"
        />
    </div>
</div>

<div id="hero-description"></div>
<br class="line" />
