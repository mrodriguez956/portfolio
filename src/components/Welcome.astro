---
import tape from "../assets/tape.png";
---

<div
    class="relative grid grid-cols-1 md:grid-cols-5 text-white p-5 md:p-10 items-center overflow-hidden"
>
    <div class="relative z-10 h-full items-center hero-name md:col-span-3">
        <span class="lg:text-2xl font-bold text-wheat">
            from the console of Michael Rodriguez
        </span>
        <h1 class="text-[55px] xl:text-[110px] leading-none">
            Full-Stack Engineer
        </h1>
        <div class="py-2 lg:text-3xl">
            Creating analog experiences in the digital realm.
        </div>
    </div>

    <img
        class="absolute inset-0 w-full h-full object-contain z-0"
        src={tape.src}
        alt="A VHS tape with a custom label"
    />

    <div class="md:col-span-2 tape-container"></div>
</div>
