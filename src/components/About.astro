---
import aboutImage from "../assets/About.svg";
import aboutSide from "../assets/about-image.png";
---

<section>
    <h2 class="section-header text-center text-[40px] flex justify-center">
        <img class="w-[400px]" src={aboutImage.src} alt="About" />
    </h2>
    <div class="grid md:grid-cols-2">
        <div class="flex justify-center">
            <img
                class="w-[100%]"
                src={aboutSide.src}
                alt="Abstract background"
            />
        </div>
        <p
            class="text-[18px] lg:text-[25px] p-5 mt-8 md:mt-0 content-center transform -rotate-3"
        >
            <span
                class="float-left text-red-500 text-7xl lg:text-[90px] font-extrabold leading-none"
                >F</span
            >using the nostalgic energy of the 90s with the power of modern web
            technologies, my work resurrects the creative spirit of the early
            internet to deliver cutting-edge, memorable experiences. My passion
            for this style is built on a strong foundation of modern development
            practices, allowing me to create everything from unique, expressive
            websites to clean, professional, and effective solutions for any
            client.
        </p>
    </div>
</section>
