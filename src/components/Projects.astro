---
import dbdVHS from "../assets/VHS-DBD.png";
import twVHS from "../assets/VHS-TW.png";
import wipVHS from "../assets/VHS-WIP.svg";
import blogVHS from "../assets/VHS-BLOG.svg";
import dbdVert from "../assets/VHS-DBD-V.png";
import twVert from "../assets/VHS-TW-V.png";
import wipVert from "../assets/VHS-WIP-V.svg";
import blogVert from "../assets/VHS-BLOG-V.svg";

const projects = [
    {
        title: "Dead by Daylight 90's Generator",
        description: "Custom Icon Generator for Dead by Daylight",
        image: dbdVHS,
        vertical: dbdVert,
        preview: "../src/assets/90s-preview.png",
        link: "https://mrodriguez956.github.io/90s-Generator/",
    },
    {
        title: "TimeWizard",
        description: "Another cool project",
        image: twVHS,
        vertical: twVert,
        preview: "../src/assets/TW-preview.png",
        link: "https://mrodriguez956.github.io/Time-Wizard/",
    },
    {
        title: "The Blog",
        description: "Custom Wordpress Theme inspired by Shirtz.cool",
        image: blogVHS,
        vertical: blogVert,
        preview: "../src/assets/blog-preview.png",
        link: "https://mrodriguez956.github.io/the-blog/",
    },
    {
        title: "WordPress Theme",
        description: "Custom Wordpress Theme inspired by Shirtz.cool",
        image: wipVHS,
        vertical: wipVert,
        preview: "https://placecats.com/millie_neo/300/200",
    },
];
---

<div class="vhs-stack md:flex hidden px-[5px] col-span-1 text-center mr-5">
    {
        projects.map((project) =>
            project.image ? (
                <img
                    class="tape"
                    src={project.image.src}
                    alt={project.title}
                    data-preview={project.preview}
                    data-link={project.link}
                />
            ) : (
                <div
                    data-preview={project.preview}
                    data-link={project.link}
                    class="tape flex items-center justify-center bg-gray-500 text-white text-lg text-center p-2 rounded-md"
                    style="width: 200px; height: 40px;"
                >
                    {project.title}
                </div>
            ),
        )
    }
</div>

<div class="md:hidden flex items-center h-[280px] px-[5px] text-center mr-5">
    {
        projects.map((project) =>
            project.vertical ? (
                <img
                    class="tape h-[260px] w-auto mr-4"
                    src={project.vertical.src}
                    alt={project.title}
                    data-preview={project.preview}
                    data-link={project.link}
                />
            ) : (
                <div
                    data-preview={project.preview}
                    class="tape flex items-center justify-center bg-gray-500 text-white text-lg text-center p-2 rounded-md"
                    style="width: 150px; height: 260px; margin-right: 1rem; writing-mode: vertical-rl;"
                >
                    Coming Soon
                </div>
            ),
        )
    }
</div>
