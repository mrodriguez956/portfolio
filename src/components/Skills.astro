---
const identity = {
    firstName: "Michael",
    country: "Texas",
    occupation: "Help Desk Support Technician",
    education:
        "Bachelor's Degree in Computer Science (University of Texas at San Antonio)",
    hobbies: ["Gaming", "Web Dev", "card collecting"],
    food: ["Sandwiches"],
    favoriteWorks: ["Donnie Darko", "Late Night with the Devil", "Mr. Robot"],
};

const starring = [
    { skill: "React" },
    { skill: "Astro" },
    { skill: "Tailwind" },
    { skill: "Python" },
];

const backendBy = [
    { skill: "Node.js" },
    { skill: "PHP" },
    { skill: "Java" },
    { skill: "SQL" },
];

const graphicsCreatedIn = [{ skill: "Adobe Suite" }, { skill: "Blender" }];

const coreTechnologies = [
    { skill: "HTML" },
    { skill: "CSS" },
    { skill: "JavaScript" },
    { skill: "Git" },
    { skill: "npm" },
    { skill: "Bootstrap" },
];

const alsoFeaturing = [
    { skill: "Google Analytics" },
    { skill: "Wordpress" },
    { skill: "AWS" },
    { skill: "Fabric.js" },
    { skill: "Bash" },
    { skill: "Linux" },
    { skill: "Visual Studio Code" },
];

const skillColor = "white";
const fontWeight = "bold";
const textCase = "uppercase";
---

<fieldset
    class="text-center mt-20 border-2 border-gray-700 p-8 md:px-16 max-w-4xl w-full"
>
    <legend class="horror-title text-4xl sm:text-5xl md:text-6xl lg:text-7xl">SKILLS</legend>
    <p class="horror-tagline">Some things can't be unlearned...</p>

    <!-- Image Placeholder -->
    <div style="margin: 0 auto 3rem; width: 200px;">
        <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="1"
            style="opacity: 0.8;"
        >
            <path
                d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"
            ></path>
            <path d="M12 6v12M6 12h12"></path>
        </svg>
        <p style="font-size: 10px; color: #6b7280; margin-top: 0.5rem;">
            A brain with a VHS tape inserted into it
        </p>
    </div>

    <div
        class="billing-font"
        style="display: flex; flex-wrap: wrap; justify-content: center; gap: 3rem 3rem;"
    >
        <!-- Starring Section -->
        <div class="credit-section">
            <h3 class="credit-title">Starring</h3>
            <div
                class="skill-name"
                style="display: flex; justify-content: center; gap: 1.5rem;"
            >
                {
                    starring.map((skill) => (
                        <span class="text-2xl md:text-3xl lg:text-4xl">{skill.skill.toUpperCase()}</span>
                    ))
                }
            </div>
        </div>

        <!-- Backend Section -->
        <div class="credit-section">
            <h3 class="credit-title">Backend by</h3>
            <div
                class="skill-name"
                style="display: flex; justify-content: center; gap: 1.5rem;"
            >
                {
                    backendBy.map((skill) => (
                        <span class="text-2xl md:text-3xl lg:text-4xl">{skill.skill.toUpperCase()}</span>
                    ))
                }
            </div>
        </div>

        <!-- Graphics Section -->
        <div class="credit-section">
            <h3 class="credit-title">Graphics created in</h3>
            <div
                class="skill-name"
                style="display: flex; justify-content: center; gap: 1.5rem;"
            >
                {
                    graphicsCreatedIn.map((skill) => (
                        <span class="text-2xl md:text-3xl lg:text-4xl">{skill.skill.toUpperCase()}</span>
                    ))
                }
            </div>
        </div>

        <!-- Core Tech Section -->
        <div class="credit-section" style="width: 100%;">
            <h3 class="credit-title">Core Technologies</h3>
            <p class="text-credits" style="max-width: 36rem; margin: 0 auto;">
                {coreTechnologies.map((s) => s.skill.toUpperCase()).join(" • ")}
            </p>
        </div>

        <!-- Also Featuring Section -->
        <div class="credit-section" style="width: 100%;">
            <h3 class="credit-title">Also Featuring</h3>
            <p class="text-credits" style="max-width: 36rem; margin: 0 auto;">
                {alsoFeaturing.map((s) => s.skill.toUpperCase()).join(" • ")}
            </p>
        </div>
    </div>
</fieldset>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Creepster&family=Inter:wght@300;400&display=swap");

    .horror-title {
        font-family: "Creepster", cursive;
        line-height: 1;
        font-weight: 700;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .horror-tagline {
        font-style: italic;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: #888;
        padding-top: 0;
        margin-bottom: 2rem;
    }

    .billing-font {
        font-family: "OptiStevas", sans-serif;
        text-transform: uppercase;
        line-height: 0.9;
    }

    .credit-title {
        font-family: "OptiStevas", sans-serif;
        font-size: 0.8rem;
        letter-spacing: 3px;
        font-weight: 300;
        color: #ccc;
        margin-bottom: 4px;
        text-transform: uppercase;
    }

    .skill-name {
        font-family: "OptiStevas", sans-serif;
        color: #fff;
        letter-spacing: 1px;
    }

    .credit-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .text-credits {
        font-family: "OptiStevas", sans-serif;
        font-size: 1rem;
        color: #bbb;
        letter-spacing: 1px;
        line-height: 1.5;
        text-transform: uppercase;
    }
</style>
